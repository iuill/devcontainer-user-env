#!/usr/bin/env bash

set -euo pipefail

command -v docker >/dev/null 2>&1 || {
    printf 'build-agent-inbox: docker was not found in PATH\n' >&2
    exit 127
}

script_path="$(readlink -f "${BASH_SOURCE[0]}")"
repository_root="$(cd "$(dirname "$script_path")/.." && pwd)"
go_image="${AGENT_INBOX_GO_IMAGE:-golang:1.27-alpine@sha256:4c9fe60190a2a3350ddc51de80d0224b8a6698d12bdfc999fee45ea9d6c46dbc}"

mkdir -p "${repository_root}/build"

docker run --rm \
    --user "$(id -u):$(id -g)" \
    --env CGO_ENABLED=0 \
    --env GOCACHE=/tmp/go-build \
    --env GOMODCACHE=/tmp/go-mod \
    --env GOTOOLCHAIN=local \
    --mount "type=bind,source=${repository_root},target=/src" \
    --workdir /src \
    "$go_image" \
    sh -eu -c 'go test ./agent-inbox
go vet ./agent-inbox
unformatted="$(gofmt -l agent-inbox)"
if [ -n "$unformatted" ]; then
    printf "Unformatted files:\n%s\n" "$unformatted" >&2
    gofmt -d agent-inbox >&2
    exit 1
fi
go build -trimpath -ldflags="-s -w" -o build/agent-inbox ./agent-inbox'

printf 'Built %s\n' "${repository_root}/build/agent-inbox"
