[Unit]
Description=Screenshot Web for Dev Containers
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/share/devcontainer-user-env/bin/screenshot-web
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/screenshots

[Install]
WantedBy=default.target
